# Host port for the Compose database. Change it (and the two URLs below) if 5432 is already in use.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tglobal
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tglobal_test
API_PORT=3001
WEB_PORT=5173
GOLD_RATE_24K_PAISE_PER_GRAM=700000
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_MS=30000
# Optional fallback LLM, used only when the primary is unavailable (any OpenAI-compatible endpoint).
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1/
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# Requests per minute per IP; 0 turns the limit off.
RATE_LIMIT_LEADS_PER_MINUTE=20
RATE_LIMIT_AGENT_PER_MINUTE=30
# Passcode for the admin page and admin endpoints (sent as X-Admin-Passcode). Empty leaves them open.
ADMIN_PASSCODE=
