{
  "name": "@tglobal/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "@tglobal/shared": "*",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.12",
    "@types/supertest": "^6.0.3",
    "fast-check": "^3.23.2",
    "prisma": "^6.18.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
}
